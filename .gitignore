# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Local Netlify folder
.netlify

# Playwright
test-results/
playwright-report/

# Tina CLI build cache (regenerated locally / on CI)
tina/__generated__/.cache/

# Tina CLI inlines TINA_TOKEN here; we use src/lib/tina-graphql-client.ts instead.
tina/__generated__/client.ts

# Visual companion (browser mockups / selections)
.superpowers/

# Lighthouse CI local reports
.lighthouseci/

# Ad-hoc Lighthouse / speed-test output (never commit)
.lighthouseci-live/

# Generated responsive image variants (built in CI via `pnpm run images:build`)
public/images/_gen/

# Netlify headers file (generated at build time)
public/_headers

# Tina generated artifacts (do not commit)
tina/__generated__/

# Local scratch (e.g. lottie processing)
tmp/
