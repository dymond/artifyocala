---
/**
 * Byooooob-style hero scene: 3D-flip cards use only `brickGlamGallery` photography (no logos/schedules).
 */
import { brickGlamGallery } from '../../lib/site-images';

const G = brickGlamGallery;
/** Gallery JPEGs vary; single size hint for layout/LCP. */
const PHOTO = { width: 1600, height: 1067 } as const;
const galleryAlt = 'Brick City Glam — live performance photograph';

type BobClass =
  | 'artify-hero-card-bob-1'
  | 'artify-hero-card-bob-2'
  | 'artify-hero-card-bob-3'
  | 'artify-hero-card-bob-4';

type FlipClass = 'artify-hero-flip-a' | 'artify-hero-flip-b' | 'artify-hero-flip-c' | 'artify-hero-flip-d';

type CardVariant = 'bleed' | 'arch' | 'wide';

type CardConfig = {
  variant: CardVariant;
  front: { src: string; alt: string; width: number; height: number };
  back: { src: string; alt: string; width: number; height: number };
  frontCaption: string;
  frontStripClass: string;
  backCaption: string;
  backStripClass: string;
  bob: BobClass;
  flip: FlipClass;
  box: string;
  /** Negative offset into bob/flip cycles so cards desync. */
  layerDelaySec: number;
  loading: 'eager' | 'lazy';
  fetchPriority: 'high' | 'auto';
};

function faceRound(v: CardVariant): string {
  if (v === 'arch') return 'rounded-t-[2.75rem] rounded-b-2xl';
  if (v === 'wide') return 'rounded-3xl';
  return 'rounded-2xl';
}

function aspectInner(v: CardVariant): string {
  if (v === 'bleed' || v === 'wide') return 'aspect-[5/4]';
  return 'aspect-[4/5]';
}

function photoRoundBleed(v: CardVariant): string {
  if (v === 'wide') return 'rounded-2xl sm:rounded-3xl';
  return 'rounded-xl';
}

const cards: ReadonlyArray<CardConfig> = [
  {
    variant: 'bleed',
    front: {
      src: G[0],
      alt: `${galleryAlt} (A)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    back: {
      src: G[10],
      alt: `${galleryAlt} (B)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    frontCaption: 'Wings & glitter & grit',
    frontStripClass:
      'bg-buzz/95 font-display text-[0.58rem] font-extrabold leading-tight text-ink',
    backCaption: 'Totally different frame',
    backStripClass: 'bg-ink font-display text-[0.54rem] font-extrabold uppercase tracking-[0.12em] text-mist',
    bob: 'artify-hero-card-bob-1',
    flip: 'artify-hero-flip-a',
    box: 'left-[5%] top-[5%] w-[min(94%,13.75rem)] sm:left-[7%] sm:top-[7%] sm:w-[min(88%,15.75rem)]',
    layerDelaySec: 0.8,
    loading: 'eager',
    fetchPriority: 'high',
  },
  {
    variant: 'arch',
    front: {
      src: G[2],
      alt: `${galleryAlt} (C)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    back: {
      src: G[11],
      alt: `${galleryAlt} (D)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    frontCaption: 'Main character energy',
    frontStripClass:
      'bg-surge font-display text-[0.62rem] font-bold leading-tight tracking-tight text-mist sm:text-[0.65rem]',
    backCaption: 'Back side, different photo',
    backStripClass: 'bg-ink font-display text-[0.54rem] font-extrabold uppercase tracking-[0.12em] text-mist',
    bob: 'artify-hero-card-bob-2',
    flip: 'artify-hero-flip-b',
    box: 'right-[-2%] top-[11%] w-[min(94%,14.25rem)] sm:right-[0%] sm:top-[13%] sm:w-[min(88%,16.25rem)]',
    layerDelaySec: 5.5,
    loading: 'lazy',
    fetchPriority: 'auto',
  },
  {
    variant: 'bleed',
    front: {
      src: G[4],
      alt: `${galleryAlt} (E)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    back: {
      src: G[12],
      alt: `${galleryAlt} (F)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    frontCaption: 'Ok who brought snacks',
    frontStripClass:
      'bg-mist font-display text-[0.56rem] font-bold italic leading-tight text-ink',
    backCaption: 'Another moment entirely',
    backStripClass: 'bg-ink font-display text-[0.54rem] font-extrabold uppercase tracking-[0.12em] text-mist',
    bob: 'artify-hero-card-bob-3',
    flip: 'artify-hero-flip-c',
    box: 'left-[3%] bottom-[2%] w-[min(92%,13.25rem)] sm:left-[5%] sm:bottom-[4%] sm:w-[min(86%,14.75rem)]',
    layerDelaySec: 2.9,
    loading: 'lazy',
    fetchPriority: 'auto',
  },
  {
    variant: 'wide',
    front: {
      src: G[6],
      alt: `${galleryAlt} (G)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    back: {
      src: G[13],
      alt: `${galleryAlt} (H)`,
      width: PHOTO.width,
      height: PHOTO.height,
    },
    frontCaption: 'Standing O pending',
    frontStripClass:
      'bg-club font-display text-[0.56rem] font-extrabold uppercase tracking-wide text-mist',
    backCaption: 'Yep — new pic back here',
    backStripClass: 'bg-surge font-display text-[0.54rem] font-extrabold uppercase tracking-[0.1em] text-mist',
    bob: 'artify-hero-card-bob-4',
    flip: 'artify-hero-flip-d',
    box: 'right-[1%] bottom-[3%] w-[min(88%,12.25rem)] sm:right-[3%] sm:bottom-[4%] sm:w-[min(82%,13.75rem)]',
    layerDelaySec: 7.1,
    loading: 'lazy',
    fetchPriority: 'auto',
  },
];

const faceRoundClass = (c: CardConfig) => faceRound(c.variant);
const aspectClass = (c: CardConfig) => aspectInner(c.variant);
const bleedPhotoRound = (c: CardConfig) => photoRoundBleed(c.variant);
---

<div
  class="artify-hero-playful relative flex min-h-0 w-full min-w-0 max-lg:order-3 lg:min-h-0 lg:flex-1 lg:flex-col"
  aria-label="Collage of Artify programs and community"
>
  <div
    class="artify-hero-scene-grid relative mx-auto min-h-[26.5rem] w-full flex-1 overflow-visible rounded-2xl border-[3px] border-ink p-4 shadow-[8px_8px_0_0_var(--color-ink)] sm:min-h-[31rem] sm:p-5 lg:h-full lg:min-h-0"
  >
    <div
      class="pointer-events-none absolute left-[38%] bottom-[34%] w-[3.35rem] sm:left-[40%] sm:bottom-[32%] sm:w-[3.85rem]"
      style="animation-delay: -2.7s"
      aria-hidden="true"
    >
      <svg
        class="artify-hero-goofy-wobble h-full w-full drop-shadow-[2px_2px_0_var(--color-ink)]"
        viewBox="0 0 40 40"
        fill="none"
        role="img"
      >
        <title>Decorative smiley face</title>
        <circle cx="20" cy="20" r="17.5" fill="var(--color-mist)" stroke="var(--color-ink)" stroke-width="2.5"></circle>
        <circle cx="13" cy="17" r="2.8" fill="var(--color-ink)"></circle>
        <circle cx="27" cy="17" r="2.8" fill="var(--color-ink)"></circle>
        <path
          d="M11 25q9 10 18 0"
          stroke="var(--color-ink)"
          stroke-width="2.75"
          stroke-linecap="round"
          fill="none"
        ></path>
      </svg>
    </div>

    <div
      class="pointer-events-auto absolute left-[46%] top-[8%] z-[25] -translate-x-1/2 sm:left-[48%] sm:top-[10%]"
      aria-hidden="true"
    >
      <div
        class="inline-flex rotate-[-8deg] items-center gap-2.5 rounded-full border-[3px] border-ink bg-white px-3.5 py-2 shadow-[4px_4px_0_0_var(--color-ink)]"
        data-artify-hero-eyes
      >
        <span
          class="relative inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border-2 border-ink bg-mist"
        >
          <span
            class="artify-hero-pupil pointer-events-none absolute left-1/2 top-1/2 z-[1] h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink"
          ></span>
          <span
            class="artify-hero-eye-lid pointer-events-none absolute bottom-0 left-1/2 z-[2] h-[20%] w-[118%] -translate-x-1/2 rounded-t-[9999px] border-x-2 border-b-2 border-ink"
            aria-hidden="true"
          >
            <svg
              class="pointer-events-none absolute left-1/2 top-0 w-[125%] max-w-none -translate-x-1/2 -translate-y-[15%] text-ink"
              viewBox="0 0 36 9"
              fill="none"
              aria-hidden="true"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M5 2v4.5M11 1.5l-.5 5M17 2v5M23 1.5l.5 5M29 2v4.5"
              ></path>
            </svg>
          </span>
          <span
            class="artify-hero-eye-lid artify-hero-eye-shutter artify-hero-eye-shutter--blink pointer-events-none absolute inset-0 z-[4] origin-top"
            aria-hidden="true"
          >
            <svg
              class="pointer-events-none absolute bottom-0 left-1/2 w-[135%] max-w-none -translate-x-1/2 text-ink"
              viewBox="0 0 36 11"
              fill="none"
              aria-hidden="true"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M2 10l1-5.5M7 10V4M12 10l1-6M18 10V3.5M24 10l-1-6M29 10V4M34 10l-1-5.5"
              ></path>
            </svg>
          </span>
        </span>
        <span
          class="relative inline-flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border-2 border-ink bg-mist"
        >
          <span
            class="artify-hero-pupil pointer-events-none absolute left-1/2 top-1/2 z-[1] h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink"
          ></span>
          <span
            class="artify-hero-eye-lid pointer-events-none absolute bottom-0 left-1/2 z-[2] h-[20%] w-[118%] -translate-x-1/2 rounded-t-[9999px] border-x-2 border-b-2 border-ink"
            aria-hidden="true"
          >
            <svg
              class="pointer-events-none absolute left-1/2 top-0 w-[125%] max-w-none -translate-x-1/2 -translate-y-[15%] text-ink"
              viewBox="0 0 36 9"
              fill="none"
              aria-hidden="true"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M5 2v4.5M11 1.5l-.5 5M17 2v5M23 1.5l.5 5M29 2v4.5"
              ></path>
            </svg>
          </span>
          <span
            class="artify-hero-eye-lid artify-hero-eye-shutter artify-hero-eye-shutter--blink artify-hero-eye-shutter--blink-delay pointer-events-none absolute inset-0 z-[4] origin-top"
            aria-hidden="true"
          >
            <svg
              class="pointer-events-none absolute bottom-0 left-1/2 w-[135%] max-w-none -translate-x-1/2 text-ink"
              viewBox="0 0 36 11"
              fill="none"
              aria-hidden="true"
            >
              <path
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M2 10l1-5.5M7 10V4M12 10l1-6M18 10V3.5M24 10l-1-6M29 10V4M34 10l-1-5.5"
              ></path>
            </svg>
          </span>
        </span>
      </div>
    </div>

    {
      cards.map((c) => {
        const r = faceRoundClass(c);
        const a = aspectClass(c);
        const bRound = bleedPhotoRound(c);
        return (
        <article
          class:list={[
            'pointer-events-none absolute z-[22] origin-center',
            c.bob,
            c.box,
          ]}
          style={`animation-delay: -${c.layerDelaySec}s`}
        >
          <div class:list={['relative w-full origin-center', a]}>
            <div class="absolute inset-0 [perspective:1100px]">
              <div class:list={['artify-hero-flip-inner absolute inset-0 min-h-0 w-full', c.flip]}>
                {(c.variant === 'bleed' || c.variant === 'wide') && (
                  <div
                    class:list={[
                      'artify-hero-flip-face artify-hero-flip-face--front absolute inset-0 flex flex-col overflow-hidden border-[3px] border-ink bg-[#f4f2ea] shadow-[8px_8px_0_0_var(--color-ink)]',
                      r,
                    ]}
                  >
                    <div class="relative min-h-0 flex-1 p-1 sm:p-1.5">
                      <img
                        src={c.front.src}
                        alt={c.front.alt}
                        width={c.front.width}
                        height={c.front.height}
                        loading={c.loading}
                        decoding="async"
                        fetchpriority={c.fetchPriority}
                        class:list={[
                          'box-border h-full w-full max-h-full border-[3px] border-ink object-cover object-center',
                          bRound,
                        ]}
                      />
                    </div>
                    <div
                      class:list={[
                        'shrink-0 border-t-[3px] border-ink px-1.5 py-[0.2rem] text-center text-[0.56rem] leading-tight sm:py-0.5 sm:text-[0.58rem]',
                        c.frontStripClass,
                      ]}
                    >
                      {c.frontCaption}
                    </div>
                  </div>
                )}

                {c.variant === 'arch' && (
                  <div
                    class:list={[
                      'artify-hero-flip-face artify-hero-flip-face--front absolute inset-0 flex flex-col overflow-hidden border-[3px] border-ink bg-[#f4f2ea] shadow-[8px_8px_0_0_var(--color-ink)]',
                      r,
                    ]}
                  >
                    <div
                      class="relative min-h-0 w-full flex-1 overflow-hidden rounded-t-[2.5rem] border-b-[3px] border-ink bg-ink"
                    >
                      <img
                        src={c.front.src}
                        alt={c.front.alt}
                        width={c.front.width}
                        height={c.front.height}
                        loading={c.loading}
                        decoding="async"
                        fetchpriority={c.fetchPriority}
                        class="absolute inset-0 h-full w-full object-cover object-center"
                      />
                    </div>
                    <div
                      class:list={[
                        'shrink-0 px-1.5 py-[0.2rem] text-center leading-tight sm:py-0.5',
                        c.frontStripClass,
                      ]}
                    >
                      {c.frontCaption}
                    </div>
                  </div>
                )}

                {(c.variant === 'bleed' || c.variant === 'wide') && (
                  <div
                    class:list={[
                      'artify-hero-flip-face artify-hero-flip-face--back absolute inset-0 flex flex-col overflow-hidden border-[3px] border-ink bg-ink shadow-[8px_8px_0_0_var(--color-ink)]',
                      r,
                    ]}
                  >
                    <div class="relative min-h-0 flex-1 p-1 sm:p-1.5">
                      <img
                        src={c.back.src}
                        alt={c.back.alt}
                        width={c.back.width}
                        height={c.back.height}
                        loading={c.loading}
                        decoding="async"
                        class:list={[
                          'box-border h-full w-full max-h-full border-[3px] border-mist/35 object-cover object-center',
                          bRound,
                        ]}
                      />
                      <div
                        class="pointer-events-none absolute right-1 top-1 flex h-5 w-5 items-center justify-center rounded-full border-2 border-ink bg-surge text-[0.5rem] font-bold leading-none text-mist shadow-[2px_2px_0_0_var(--color-ink)]"
                        aria-hidden="true"
                      >
                        ★
                      </div>
                    </div>
                    <div
                      class:list={[
                        'shrink-0 border-t-[3px] border-ink px-1.5 py-[0.2rem] text-center text-[0.54rem] leading-tight sm:py-0.5 sm:text-[0.56rem]',
                        c.backStripClass,
                      ]}
                    >
                      {c.backCaption}
                    </div>
                  </div>
                )}

                {c.variant === 'arch' && (
                  <div
                    class:list={[
                      'artify-hero-flip-face artify-hero-flip-face--back absolute inset-0 flex flex-col overflow-hidden border-[3px] border-ink bg-ink shadow-[8px_8px_0_0_var(--color-ink)]',
                      r,
                    ]}
                  >
                    <div
                      class="relative min-h-0 w-full flex-1 overflow-hidden rounded-t-[2.5rem] border-b-[3px] border-ink bg-ink"
                    >
                      <img
                        src={c.back.src}
                        alt={c.back.alt}
                        width={c.back.width}
                        height={c.back.height}
                        loading={c.loading}
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover object-center"
                      />
                    </div>
                    <div
                      class:list={[
                        'shrink-0 px-1.5 py-[0.2rem] text-center text-[0.54rem] leading-tight sm:py-0.5 sm:text-[0.56rem]',
                        c.backStripClass,
                      ]}
                    >
                      {c.backCaption}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
        );
      })
    }
  </div>
</div>

<script>
  import {
    offsetTowardPointClamped,
    HERO_EYE_CLAMP,
    HERO_EYE_PUPIL_Y_BIAS_PX,
  } from '../../lib/hero-eyes';

  function bindHeroEyes(): () => void {
    const root = document.querySelector('[data-artify-hero-eyes]');
    if (!root) return () => {};

    const pupils = root.querySelectorAll<HTMLElement>('.artify-hero-pupil');
    if (pupils.length === 0) return () => {};

    const move = (clientX: number, clientY: number): void => {
      const rect = root.getBoundingClientRect();
      const { x, y } = offsetTowardPointClamped(clientX, clientY, rect, HERO_EYE_CLAMP);
      const yb = y + HERO_EYE_PUPIL_Y_BIAS_PX;
      for (const el of pupils) {
        el.style.transform = `translate3d(calc(-50% + ${x}px), calc(-50% + ${yb}px), 0)`;
      }
    };

    const onPointer = (e: PointerEvent): void => {
      move(e.clientX, e.clientY);
    };

    const reset = (): void => {
      const b = HERO_EYE_PUPIL_Y_BIAS_PX;
      for (const el of pupils) {
        el.style.transform = `translate3d(-50%, calc(-50% + ${b}px), 0)`;
      }
    };

    window.addEventListener('pointermove', onPointer, { passive: true });
    window.addEventListener('blur', reset);
    root.addEventListener('pointerleave', reset);

    return () => {
      window.removeEventListener('pointermove', onPointer);
      window.removeEventListener('blur', reset);
      root.removeEventListener('pointerleave', reset);
    };
  }

  let teardown: (() => void) | undefined;

  function setup(): void {
    teardown?.();
    teardown = bindHeroEyes();
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
