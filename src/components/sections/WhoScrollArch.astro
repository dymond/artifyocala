---
import Button from '../ui/Button.astro';
import { img } from '../../lib/site-images';
---

<section
  id="who"
  class="overflow-x-clip bg-mist text-ink"
  aria-labelledby="who-heading"
>
  {/*
    Mirrors Webflow structure: .sticky-arc-wrap (tall) > .sticky-arc (sticky, flex-end) >
    .sticky-arc-element (overflow hidden, top radii = arch, grows w/h). Copy centered like .our-menu-wrapper.
  */}
  <div class="artify-who-driver w-full max-w-none min-h-[280vh]">
    <div class="artify-who-sticky sticky top-0 z-0 flex h-dvh min-h-[26rem] w-full items-end justify-center overflow-hidden bg-mist" >
      <div class="artify-who-webgl-wrap pointer-events-none absolute inset-0 z-[1] opacity-[0.92]" aria-hidden="true" >
        <canvas
          id="artify-who-canvas"
          class="min-h-0 min-w-0 bg-[#f4f5fc]"
        ></canvas>
      </div>
      <div class="artify-who-arch-frame relative z-[2] bg-ink">
        <img
          src={img.communityFeatured}
          alt="Community members at an Artify Ocala event"
          width={1317}
          height={1756}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 z-0 h-full max-h-none w-full object-cover object-[center_30%]"
        />
        <div class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-b from-ink/52 via-ink/26 via-35% to-ink/86" aria-hidden="true" />
        {/*
          Soft radial darkening behind the copy only — no card/box, fades to transparent.
        */}
        <div class="artify-who-readability-vignette pointer-events-none absolute inset-0 z-[1]" aria-hidden="true" />
        <div class="artify-who-copy-layer dark-surface absolute inset-0 z-[2] flex flex-col items-center justify-center gap-0 py-xl text-center" >
          {/*
            Inner width uses viewport (final) measure so line-length doesn’t reflow as the arch
            grows — the frame’s overflow:hidden reveals the pre-sized block.
          */}
          <div class="artify-who-copy-inner flex shrink-0 flex-col items-center px-[max(var(--spacing-md),env(safe-area-inset-left))] sm:px-lg">
            <p
              class="mb-2 font-display text-[0.82rem] font-extrabold uppercase tracking-[0.24em] text-accent-soft"
            >
              The crew
            </p>
            <h2
              id="who-heading"
              class="mb-sm font-display text-[clamp(2rem,4.5vw,3.35rem)] font-bold leading-[1.06] tracking-[-0.02em] text-mist"
            >
              Who we are
            </h2>
            <p
              class="artify-who-lede mb-lg max-w-none text-balance text-[1.22rem] font-medium leading-[1.62] text-mist sm:text-[1.32rem] md:text-[1.38rem]"
            >
              Since 2017 Artify Ocala has served Marion County alongside visual and
              performing artists from many disciplines. We connect people to
              opportunities to showcase work and weave artistry into everyday
              community life.
            </p>
            <div>
              <Button href="/about" tone="surge">About us</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { importWhoArchBackdropModule } from '../../scripts/who-arch-loader';

  type WhoMod = typeof import('../../scripts/who-arch-backdrop');

  let whoMod: WhoMod | null = null;
  let whoIo: IntersectionObserver | null = null;
  /** Bumps on teardown so in-flight `import()` doesn’t mount after navigation away. */
  let whoLoadGen = 0;

  function teardownWhoArchBackdrop(): void {
    whoLoadGen += 1;
    whoIo?.disconnect();
    whoIo = null;
    if (whoMod) {
      whoMod.unmountWhoArchBackdrop();
    }
  }

  async function loadAndMountWhoArchBackdrop(): Promise<void> {
    const gen = whoLoadGen;
    if (!whoMod) {
      whoMod = await importWhoArchBackdropModule();
    }
    if (gen !== whoLoadGen) return;
    whoMod.mountWhoArchBackdrop();
  }

  function setupWhoArchBackdrop(): void {
    if (typeof window === 'undefined' || typeof document === 'undefined') return;

    teardownWhoArchBackdrop();

    const who = document.getElementById('who');
    if (!who) return;

    const kickoff = (): void => {
      void loadAndMountWhoArchBackdrop();
    };

    if (!('IntersectionObserver' in window)) {
      kickoff();
      return;
    }

    whoIo = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        whoIo?.disconnect();
        whoIo = null;
        kickoff();
      },
      { root: null, rootMargin: '280px 0px 320px 0px', threshold: 0 },
    );
    whoIo.observe(who);
  }

  document.addEventListener('astro:page-load', setupWhoArchBackdrop);
  setupWhoArchBackdrop();
</script>
