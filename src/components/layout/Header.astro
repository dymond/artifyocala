---
import { img } from '../../lib/site-images';

const pathname = Astro.url.pathname;

/** Menu arc only — Home lives on the island. */
const menuArcItems = [
  { href: '/about', label: 'About' },
  { href: '/volunteer', label: 'Volunteer' },
  { href: '/donate', label: 'Donate' },
  {
    href: '/programs/maker-collective',
    label: 'Makers',
    ariaLabel: 'Marion County Maker Collective',
  },
  {
    href: '/programs/maker-collective/equipment',
    label: 'Wish list',
    ariaLabel: 'Equipment wish list',
  },
  {
    href: '/programs/brick-city-glam',
    label: 'Glam',
    ariaLabel: 'Brick City Glam',
  },
  {
    href: '/programs/storytelling-knights',
    label: 'Knights',
    ariaLabel: 'Storytelling Knights',
  },
] as const;

const arcRadius = 128;

/** Upper semicircle only: from left (-180°) through top (-90°) to right (0°), y ≤ 0 in screen space. */
function arcOffset(index: number, total: number) {
  const startDeg = -178;
  const endDeg = -2;
  const t = total === 1 ? 0.5 : index / (total - 1);
  const angleDeg = startDeg + (endDeg - startDeg) * t;
  const rad = (angleDeg * Math.PI) / 180;
  return {
    x: Math.round(arcRadius * Math.cos(rad)),
    y: Math.round(arcRadius * Math.sin(rad)),
  };
}

function current(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}

const homeActive = pathname === '/';
---

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.dispatchEvent(new CustomEvent('artify:close-floating-nav'));
  });
</script>

{
  !homeActive && (
    <header
      class="relative w-full overflow-hidden border-b border-ink/10 bg-mist"
      style="padding-top: max(0.65rem, env(safe-area-inset-top, 0px));"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_120%_at_0%_0%,rgba(176,184,255,0.2),transparent_55%)]"
        aria-hidden="true"
      />
      <div class="site-container relative z-[1] flex justify-start pb-3 pt-1 md:pb-4 md:pt-1.5">
        <a
          href="/"
          class="group block w-[min(42vw,9.25rem)] shrink-0 outline-none transition-opacity duration-200 hover:opacity-[0.88] focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-mist sm:w-[10rem] md:w-[10.75rem]"
          aria-label="Artify Ocala — Home"
        >
          <img
            src={img.logoOnLightHollow}
            alt=""
            width={1600}
            height={1260}
            decoding="async"
            class="h-auto w-full object-contain object-left"
            aria-hidden="true"
          />
        </a>
      </div>
    </header>
  )
}

<!-- Bottom island + half-circle menu -->
<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-[100] flex justify-center"
  style="padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));"
  x-data="{ menuOpen: false }"
  @artify:close-floating-nav.window="menuOpen = false"
  @keydown.escape.window="menuOpen = false"
>
  <div class="pointer-events-auto relative flex flex-col items-center">
    <div
      class="pointer-events-auto fixed inset-0 z-[90] bg-void/55 backdrop-blur-[2px] transition-opacity duration-300"
      x-show="menuOpen"
      x-transition:enter="ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-cloak
      @click="menuOpen = false"
      role="presentation"
    >
    </div>

    <nav
      id="wheel-nav-panel"
      class="relative z-[100] flex w-[min(94vw,320px)] items-end justify-center transition-[height,margin] duration-200"
      x-bind:class="menuOpen ? 'mb-2 h-[min(36vh,200px)] overflow-visible' : 'mb-0 h-0 overflow-hidden'"
      aria-label="Site menu"
    >
      <div class="relative h-full min-h-0 w-full">
        {
          menuArcItems.map((item, i) => {
            const { x, y } = arcOffset(i, menuArcItems.length);
            const isActive = current(item.href);
            const a11y = 'ariaLabel' in item && item.ariaLabel ? item.ariaLabel : item.label;
            return (
              <div
                class="absolute left-1/2 top-full transition-[transform,opacity] duration-300 ease-out"
                style={`transform: translate(-50%, -50%) translate(${x}px, ${y}px); transition-delay: ${i * 32}ms;`}
                x-bind:class="menuOpen ? 'pointer-events-auto' : 'pointer-events-none'"
              >
                <a
                  href={item.href}
                  class:list={[
                    'block origin-center rounded-full border px-3 py-2 text-center text-[0.78rem] font-semibold leading-tight transition-all duration-200 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                    'max-w-[5.75rem] border-2 border-ink bg-mist text-ink shadow-[3px_3px_0_0_var(--color-ink)] no-underline hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0_0_var(--color-ink)] hover:bg-buzz hover:text-ink active:translate-x-1 active:translate-y-1 active:shadow-none',
                    isActive && 'border-surge bg-buzz ring-2 ring-surge ring-offset-2 ring-offset-mist',
                  ]}
                  x-bind:class="menuOpen ? 'scale-100 opacity-100' : 'scale-[0.35] opacity-0'"
                  aria-label={a11y}
                  @click="menuOpen = false"
                >
                  {item.label}
                </a>
              </div>
            );
          })
        }
      </div>
    </nav>

    <!-- iOS-style island: Home | Menu -->
    <div
      class="relative z-[100] flex items-center gap-1 rounded-[2rem] border-2 border-white/18 bg-void/95 px-2 py-2 shadow-[0_12px_48px_rgba(0,0,0,0.45)] ring-2 ring-buzz/30 backdrop-blur-xl"
      role="toolbar"
      aria-label="Quick navigation"
    >
      <a
        href="/"
        class:list={[
          'flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-mist no-underline transition-colors',
          'bg-white/10 hover:bg-white/18 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          homeActive && 'bg-buzz text-ink ring-2 ring-white/40',
        ]}
        aria-label="Home"
        aria-current={homeActive ? 'page' : undefined}
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V9.5z" />
        </svg>
      </a>

      <div class="mx-1 h-8 w-px shrink-0 bg-white/15" aria-hidden="true"></div>

      <button
        type="button"
        class="flex h-12 min-w-[5.5rem] shrink-0 items-center justify-center gap-2 rounded-full bg-white/14 px-4 text-sm font-bold tracking-wide text-mist transition-colors hover:bg-white/22 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        @click="menuOpen = !menuOpen"
        x-bind:aria-expanded="menuOpen"
        aria-haspopup="true"
        aria-controls="wheel-nav-panel"
        x-bind:aria-label="menuOpen ? 'Close menu' : 'Open menu'"
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
        <span x-text="menuOpen ? 'Close' : 'Menu'"></span>
      </button>
    </div>
  </div>
</div>
