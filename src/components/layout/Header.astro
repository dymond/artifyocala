---
import { headerLogoSrc, type SiteChrome } from '../../lib/site-chrome';
import ResponsiveImage from "../ui/ResponsiveImage.astro";

interface Props {
  chrome: SiteChrome;
}

const { chrome } = Astro.props;
const pathname = Astro.url.pathname;
const headerLogo = headerLogoSrc(chrome);

/** Menu arc only — Home lives on the island. */
const menuArcItems = chrome.navItems;

/**
 * Elliptical arc (md+): wider than tall so neighbors get more horizontal gap without
 * needing a huge radius that pushes pills off narrow screens. Values tuned for ~5rem pills.
 */
const arcRx = 158;
const arcRy = 80;

/** Index of the top-of-arc item (highest on screen) — used for z-stacking. */
const arcPeakIndex = Math.round((menuArcItems.length - 1) / 2);

/** Upper semicircle only: from left through top to right, y ≤ 0 in screen space. */
function arcOffset(index: number, total: number) {
  const startDeg = -178;
  const endDeg = -2;
  const t = total === 1 ? 0.5 : index / (total - 1);
  const angleDeg = startDeg + (endDeg - startDeg) * t;
  const rad = (angleDeg * Math.PI) / 180;
  return {
    x: Math.round(arcRx * Math.cos(rad)),
    y: Math.round(arcRy * Math.sin(rad)),
  };
}

/** Vertical reach of arc (ellipse) + half pill — sets desktop panel height. */
const arcPanelHeightPx = arcRy + 42;

const navStaggerEnter = (i: number) => String(i * 48);
/** Same order as enter: left / list-top first, right / list-bottom last. */
const navStaggerLeave = (i: number) => String(i * 32);

function current(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}

const homeActive = pathname === '/';

/** Alpine x-data: keep panel layout open until item leave transitions finish (max stagger + desktop duration). */
const wheelNavAlpineData = `{ menuOpen:false,navShellOpen:false,shellHoldMs:780,openLabel:${JSON.stringify(chrome.islandMenuOpenText)},closeLabel:${JSON.stringify(chrome.islandMenuCloseText)},openWheelNav(){if(this.shellTimer)clearTimeout(this.shellTimer);this.navShellOpen=true;this.$nextTick(()=>{this.menuOpen=true})},closeWheelNav(){if(!this.navShellOpen)return;this.menuOpen=false;if(this.shellTimer)clearTimeout(this.shellTimer);this.shellTimer=setTimeout(()=>{this.navShellOpen=false;this.shellTimer=null},this.shellHoldMs)},toggleWheelNav(){this.menuOpen?this.closeWheelNav():this.openWheelNav()} }`;
---

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.dispatchEvent(new CustomEvent('artify:close-floating-nav'));
  });
</script>

{
  !homeActive && (
    <header
      class="relative z-[50] w-full overflow-hidden border-b border-ink/10 bg-mist"
      style="padding-top: max(0.65rem, env(safe-area-inset-top, 0px));"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_120%_at_0%_0%,rgba(176,184,255,0.2),transparent_55%)]"
        aria-hidden="true"
      />
      <div class="site-container relative z-[1] flex justify-start pb-3 pt-1 md:pb-4 md:pt-1.5">
        <a
          href="/"
          class="group block w-[min(42vw,9.25rem)] shrink-0 outline-none transition-opacity duration-200 hover:opacity-[0.88] focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-mist sm:w-[10rem] md:w-[10.75rem]"
          aria-label={chrome.headerLogoAriaLabel}
        >
          <ResponsiveImage
            src={headerLogo}
            alt=""
            width={1600}
            height={1260}
            decoding="async"
            class="h-auto w-full object-contain object-left"
          />
        </a>
      </div>
    </header>
  )
}

<!-- Bottom island + half-circle menu -->
<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-[100] flex justify-center"
  style="padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));"
  x-data={wheelNavAlpineData}
  @artify:close-floating-nav.window="closeWheelNav()"
  @keydown.escape.window="navShellOpen && closeWheelNav()"
>
  <div class="pointer-events-auto relative flex flex-col items-center" data-artify-studio-chrome>
    <div
      class="pointer-events-auto fixed inset-0 z-[90] bg-void/55 backdrop-blur-[2px] transition-opacity duration-300"
      x-show="navShellOpen"
      x-transition:enter="ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-cloak
      @click="closeWheelNav()"
      role="presentation"
    >
    </div>

    <nav
      id="wheel-nav-panel"
      class="relative z-[100] mb-0 max-h-0 w-[min(92vw,20rem)] overflow-hidden transition-[margin,max-height] duration-300 ease-out md:w-[min(96vw,408px)]"
      x-bind:class="navShellOpen ? 'mb-3 max-h-[min(52vh,380px)] overflow-y-auto md:max-h-none md:overflow-visible' : 'mb-0 max-h-0 overflow-hidden'"
      aria-label="Site menu"
      x-cloak
    >
      <!-- Small screens: flow layout + staggered “swoop” from bottom-left. -->
      <ul class="relative m-0 flex list-none flex-col items-stretch gap-2.5 px-1 py-1 md:hidden">
        {
          menuArcItems.map((item, i) => {
            const isActive = current(item.href);
            const a11y = item.ariaLabel?.trim() ? item.ariaLabel.trim() : item.label;
            const ext = Boolean(item.external);
            const zMobile = 20 - Math.abs(i - arcPeakIndex);
            return (
              <li
                class="relative m-0 block p-0"
                style={`z-index: ${zMobile}`}
                x-show="menuOpen"
                x-transition:enter="transition duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)]"
                x-transition:enter-start="opacity-0 -translate-x-5 translate-y-4 scale-[0.92] -rotate-2"
                x-transition:enter-end="opacity-100 translate-x-0 translate-y-0 scale-100 rotate-0"
                x-transition:leave="transition duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)]"
                x-transition:leave-start="opacity-100 translate-x-0 translate-y-0 scale-100 rotate-0"
                x-transition:leave-end="opacity-0 translate-x-5 translate-y-4 scale-[0.92] rotate-2"
                data-enter-ms={navStaggerEnter(i)}
                data-leave-ms={navStaggerLeave(i)}
                x-bind:style="'transition-delay: ' + (menuOpen ? $el.dataset.enterMs : $el.dataset.leaveMs) + 'ms'"
              >
                <a
                  href={item.href}
                  target={ext ? "_blank" : undefined}
                  rel={ext ? "noopener noreferrer" : undefined}
                  class:list={[
                    'flex min-h-[2.75rem] w-full items-center justify-center rounded-full border px-3 py-2 text-center text-[0.78rem] font-semibold leading-snug transition-all duration-200 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                    'border-2 border-ink bg-mist text-ink shadow-[3px_3px_0_0_var(--color-ink)] no-underline hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0_0_var(--color-ink)] hover:bg-buzz hover:text-ink active:translate-x-1 active:translate-y-1 active:shadow-none',
                    isActive && 'border-surge bg-buzz ring-2 ring-surge ring-offset-2 ring-offset-mist',
                  ]}
                  aria-label={a11y}
                  @click="closeWheelNav()"
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- md+: compact ellipse so pills stay on-screen while separating more than a small circle. -->
      <div
        class="relative hidden min-h-0 w-full overflow-visible md:block"
        style={`height: ${arcPanelHeightPx}px`}
      >
        {
          menuArcItems.map((item, i) => {
            const { x, y } = arcOffset(i, menuArcItems.length);
            const isActive = current(item.href);
            const a11y = item.ariaLabel?.trim() ? item.ariaLabel.trim() : item.label;
            const ext = Boolean(item.external);
            const zArc = 40 - Math.abs(i - arcPeakIndex);
            return (
              <div
                class="absolute left-1/2 top-full"
                style={`transform: translate(-50%, -50%) translate(${x}px, ${y}px); z-index: ${zArc};`}
                x-bind:class="menuOpen ? 'pointer-events-auto' : 'pointer-events-none'"
              >
                <div
                  class="origin-bottom-left"
                  x-show="menuOpen"
                  x-transition:enter="transition duration-[480ms] ease-[cubic-bezier(0.34,1.15,0.48,1)] will-change-transform"
                  x-transition:enter-start="opacity-0 -translate-x-8 translate-y-10 scale-[0.35] -rotate-[12deg]"
                  x-transition:enter-end="opacity-100 translate-x-0 translate-y-0 scale-100 rotate-0"
                  x-transition:leave="transition duration-[480ms] ease-[cubic-bezier(0.34,1.15,0.48,1)] will-change-transform"
                  x-transition:leave-start="opacity-100 translate-x-0 translate-y-0 scale-100 rotate-0"
                  x-transition:leave-end="opacity-0 translate-x-8 translate-y-10 scale-[0.35] rotate-[12deg]"
                  data-enter-ms={navStaggerEnter(i)}
                  data-leave-ms={navStaggerLeave(i)}
                  x-bind:style="'transition-delay: ' + (menuOpen ? $el.dataset.enterMs : $el.dataset.leaveMs) + 'ms'"
                >
                  <a
                    href={item.href}
                    target={ext ? "_blank" : undefined}
                    rel={ext ? "noopener noreferrer" : undefined}
                    class:list={[
                      'flex min-h-[2.75rem] w-[5rem] max-w-[5rem] items-center justify-center rounded-full border px-1.5 py-2 text-center text-[0.75rem] font-semibold leading-snug transition-all duration-200 ease-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:w-[5.35rem] sm:max-w-[5.35rem] sm:text-[0.78rem]',
                      'border-2 border-ink bg-mist text-ink shadow-[3px_3px_0_0_var(--color-ink)] no-underline hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0_0_var(--color-ink)] hover:bg-buzz hover:text-ink active:translate-x-1 active:translate-y-1 active:shadow-none',
                      isActive && 'border-surge bg-buzz ring-2 ring-surge ring-offset-2 ring-offset-mist',
                    ]}
                    aria-label={a11y}
                    @click="closeWheelNav()"
                  >
                    {item.label}
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </nav>

    <!-- iOS-style island: Home | Menu -->
    <div
      class="relative z-[100] flex items-center gap-1 rounded-[2rem] border-2 border-white/18 bg-void/95 px-2 py-2 shadow-[0_12px_48px_rgba(0,0,0,0.45)] ring-2 ring-buzz/30 backdrop-blur-xl"
      role="toolbar"
      aria-label="Quick navigation"
    >
      <a
        href="/"
        class:list={[
          'flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-mist no-underline transition-colors',
          'bg-white/10 hover:bg-white/18 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          homeActive && 'bg-buzz text-ink ring-2 ring-white/40',
        ]}
        aria-label={chrome.islandHomeAriaLabel}
        aria-current={homeActive ? 'page' : undefined}
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V9.5z" />
        </svg>
      </a>

      <div class="mx-1 h-8 w-px shrink-0 bg-white/15" aria-hidden="true"></div>

      <button
        type="button"
        class="flex h-12 min-w-[5.5rem] shrink-0 items-center justify-center gap-2 rounded-full bg-white/14 px-4 text-sm font-bold tracking-wide text-mist transition-colors hover:bg-white/22 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        @click="toggleWheelNav()"
        x-bind:aria-expanded="navShellOpen"
        aria-haspopup="true"
        aria-controls="wheel-nav-panel"
        x-bind:aria-label="menuOpen ? ('Close menu (' + closeLabel + ')') : ('Open menu (' + openLabel + ')')"
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
        <span x-text="menuOpen ? closeLabel : openLabel"></span>
      </button>
    </div>
  </div>
</div>
