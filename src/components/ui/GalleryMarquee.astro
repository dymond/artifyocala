---
/**
 * Infinite horizontal photo strip(s). On lg+, a second opposite-direction row is
 * used only when each split row is wide enough to fill the shell (see
 * gallery-marquee-desktop.ts).
 */
interface Props {
  images: readonly string[];
  alt: string;
  class?: string;
  /** Card chrome: use `light` on default (mist) sections, `dark` on dark surfaces. */
  surface?: 'dark' | 'light';
  'data-testid'?: string;
}

const {
  images,
  alt,
  class: className = '',
  surface = 'dark',
  'data-testid': dataTestId,
} = Astro.props;

const desktopSplitCapable = images.length >= 4;
const mid = Math.ceil(images.length / 2);
const rowA = images.slice(0, mid);
const rowB = images.slice(mid);

const cellClass =
  surface === 'light'
    ? 'gallery-marquee-item pointer-events-auto relative m-0 h-[clamp(220px,36vh,300px)] w-[clamp(10.5rem,22vw,13.75rem)] shrink-0 [transform-style:preserve-3d] overflow-hidden rounded-xl border border-line/70 bg-ink/[0.03] shadow-none transition-[transform,box-shadow] duration-[1350ms] ease-[cubic-bezier(0.19,1,0.22,1)] motion-safe:[transform:translateZ(0)] motion-safe:hover:z-30 motion-safe:hover:[transform:translateY(-0.5rem)_translateZ(2.25rem)_rotateX(7deg)_rotateY(-6deg)_scale(1.05)] motion-safe:hover:shadow-[0_32px_64px_-12px_rgba(28,28,51,0.42),0_16px_32px_-10px_rgba(28,28,51,0.22)]'
    : 'gallery-marquee-item pointer-events-auto relative m-0 h-[clamp(220px,36vh,300px)] w-[clamp(10.5rem,22vw,13.75rem)] shrink-0 [transform-style:preserve-3d] overflow-hidden rounded-xl border border-white/12 bg-black/25 shadow-none transition-[transform,box-shadow] duration-[1350ms] ease-[cubic-bezier(0.19,1,0.22,1)] motion-safe:[transform:translateZ(0)] motion-safe:hover:z-30 motion-safe:hover:[transform:translateY(-0.5rem)_translateZ(2.25rem)_rotateX(7deg)_rotateY(-6deg)_scale(1.05)] motion-safe:hover:shadow-[0_36px_72px_-14px_rgba(0,0,0,0.78),0_18px_36px_-12px_rgba(0,0,0,0.48)]';

const imgClass = 'h-full w-full object-cover';

const viewportClass = 'gallery-marquee-viewport';
const trackClipClass = 'gallery-marquee-track-clip';

const shellAttrs = {
  'data-gallery-marquee-shell': true,
  ...(desktopSplitCapable ? { 'data-desktop-split-capable': 'true' } : {}),
};
---

<div
  class:list={[
    'gallery-marquee-shell w-full min-w-0',
    surface === 'light'
      ? '[--gallery-marquee-edge:var(--color-mist)]'
      : '[--gallery-marquee-edge:var(--color-void)]',
    className,
  ]}
  {...shellAttrs}
  data-testid={dataTestId}
>
  {
    desktopSplitCapable ? (
      <>
        <div class="lg:hidden">
          <div class={viewportClass}>
            <div class={trackClipClass}>
              <div class="artify-marquee-track artify-marquee-track--gallery">
                <div class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]">
                  {images.map((src, i) => (
                    <figure class={cellClass}>
                      <img
                        src={src}
                        alt={`${alt} ${i + 1}`}
                        class={imgClass}
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  ))}
                </div>
                <div
                  class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]"
                  aria-hidden="true"
                >
                  {images.map((src) => (
                    <figure class={cellClass}>
                      <img src={src} alt="" class={imgClass} loading="lazy" decoding="async" />
                    </figure>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="hidden min-w-0 w-full lg:block"
          data-gallery-marquee-desktop-root
        >
          <div class="gallery-marquee-dsk-single">
            <div class={viewportClass}>
              <div class={trackClipClass}>
                <div class="artify-marquee-track artify-marquee-track--gallery">
                  <div class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]">
                    {images.map((src, i) => (
                      <figure class={cellClass}>
                        <img
                          src={src}
                          alt={`${alt} ${i + 1}`}
                          class={imgClass}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))}
                  </div>
                  <div
                    class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]"
                    aria-hidden="true"
                  >
                    {images.map((src) => (
                      <figure class={cellClass}>
                        <img src={src} alt="" class={imgClass} loading="lazy" decoding="async" />
                      </figure>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="gallery-marquee-dsk-dual hidden flex flex-col gap-[var(--spacing-md)] overflow-visible">
            <div class={viewportClass}>
              <div class={trackClipClass}>
                <div
                  class="artify-marquee-track artify-marquee-track--gallery"
                  data-marquee-row="a"
                >
                  <div class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]">
                    {rowA.map((src, i) => (
                      <figure class={cellClass}>
                        <img
                          src={src}
                          alt={`${alt} ${i + 1}`}
                          class={imgClass}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))}
                  </div>
                  <div
                    class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]"
                    aria-hidden="true"
                  >
                    {rowA.map((src) => (
                      <figure class={cellClass}>
                        <img src={src} alt="" class={imgClass} loading="lazy" decoding="async" />
                      </figure>
                    ))}
                  </div>
                </div>
              </div>
            </div>
            <div class={viewportClass}>
              <div class={trackClipClass}>
                <div
                  class="artify-marquee-track artify-marquee-track--gallery-reverse"
                  data-marquee-row="b"
                >
                  <div class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]">
                    {rowB.map((src, i) => (
                      <figure class={cellClass}>
                        <img
                          src={src}
                          alt={`${alt} ${rowA.length + i + 1}`}
                          class={imgClass}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))}
                  </div>
                  <div
                    class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]"
                    aria-hidden="true"
                  >
                    {rowB.map((src) => (
                      <figure class={cellClass}>
                        <img src={src} alt="" class={imgClass} loading="lazy" decoding="async" />
                      </figure>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </>
    ) : (
      <div class={viewportClass}>
        <div class={trackClipClass}>
          <div class="artify-marquee-track artify-marquee-track--gallery">
            <div class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]">
              {images.map((src, i) => (
                <figure class={cellClass}>
                  <img
                    src={src}
                    alt={`${alt} ${i + 1}`}
                    class={imgClass}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
            <div
              class="pointer-events-none flex shrink-0 items-center gap-[var(--spacing-md)] pr-[var(--spacing-md)]"
              aria-hidden="true"
            >
              {images.map((src) => (
                <figure class={cellClass}>
                  <img src={src} alt="" class={imgClass} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          </div>
        </div>
      </div>
    )
  }
</div>

{
  desktopSplitCapable ? (
    <script>
      import {
        mountGalleryMarqueeDesktop,
        destroyGalleryMarqueeDesktop,
      } from '../../scripts/gallery-marquee-desktop.ts';

      mountGalleryMarqueeDesktop();
      document.addEventListener('astro:page-load', mountGalleryMarqueeDesktop);
      document.addEventListener('astro:before-swap', destroyGalleryMarqueeDesktop);
    </script>
  ) : null
}
