---
import type { PageSection } from "../../lib/page-sections/schema";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import { filterActiveEventTiles } from "../../lib/events";
import { imageAlt } from "../../lib/image-alt";
import { groupByMonthYear } from "../../lib/events-grouping";

interface Props {
  section: Extract<PageSection, { _template: "eventsGallery" }>;
}

const { section } = Astro.props;
const meta = section.evgTiles ?? [];
const tiles = filterActiveEventTiles(meta.filter(Boolean), new Date(), (t) => t.evtExpiresAt);
const groups = groupByMonthYear(tiles);
---

<section class="bg-mist py-2xl">
  <div class="site-container">
    <h1 class="type-display-xl">{section.evgHeading}</h1>
    {section.evgLedeHtml && (
      <div
        class="prose-inner max-w-[52rem] [&_p]:mb-md [&_a]:font-medium [&_a]:text-accent-soft [&_a]:no-underline hover:[&_a]:underline"
        set:html={section.evgLedeHtml}
      />
    )}

    {groups.map((g) => (
      <div class="mt-xl">
        <h2 class="type-display-lg mb-md border-b-2 border-ink/15 pb-sm">{g.heading}</h2>
        <div class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((t) => {
            const href = t.evtHref ?? null;
            const alt = imageAlt(t.evtAlt, "Event image");
            const frame =
              "group block cursor-pointer overflow-hidden rounded-2xl border-[3px] border-ink bg-white shadow-[10px_10px_0_0_var(--color-ink)] transition-transform duration-300 hover:-translate-y-1";
            const img = (
              <div
                class="relative h-full w-full overflow-hidden"
                style={`--artify-events-bg: url(${t.evtImage});`}
              >
                <div
                  class="pointer-events-none absolute inset-0 scale-[1.5] bg-[image:var(--artify-events-bg)] bg-cover bg-center blur-2xl opacity-80"
                  aria-hidden="true"
                />
                <div class="pointer-events-none absolute inset-0 bg-black/10" aria-hidden="true" />
                <div class="relative z-[1] h-full w-full">
                  <ResponsiveImage
                    src={t.evtImage}
                    alt={alt}
                    width={2400}
                    height={1350}
                    loading="lazy"
                    decoding="async"
                    sizes="(min-width: 1024px) min(980px, 92vw), 92vw"
                    class="block h-full w-full bg-transparent object-contain transition-transform duration-500 group-hover:scale-[1.01]"
                  />
                </div>
              </div>
            );

            return href ? (
              <a href={href} class={frame} target="_blank" rel="noopener noreferrer">
                {img}
              </a>
            ) : (
              <div class={frame}>{img}</div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

