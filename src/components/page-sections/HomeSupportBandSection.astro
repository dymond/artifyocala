---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import type { PageSection } from "../../lib/page-sections/schema";
import { imageAlt } from "../../lib/image-alt";

interface Props {
  section: Extract<PageSection, { _template: "homeSupportBand" }>;
}

const { section } = Astro.props;
const hsbAlt = imageAlt(section.hsbImageAlt, `${section.hsbHeading} — photo`);
---

<Section variant="dark" id="support">
  <div class="grid grid-cols-1 items-center gap-xl lg:grid-cols-[1fr_1.1fr]">
    <figure
      class="m-0 min-w-0 overflow-hidden rounded-xl border-[3px] border-buzz/40 shadow-[8px_8px_0_0_rgba(176,184,255,0.18)]"
    >
      <ResponsiveImage
        src={section.hsbImage}
        alt={hsbAlt}
        width={1080}
        height={1080}
        loading="lazy"
        decoding="async"
        sizes="(min-width: 1024px) 40vw, 92vw"
        class="block w-full"
      />
    </figure>
    <div class="min-w-0">
      <p
        class="mb-0 text-buzz font-display text-[0.7rem] font-extrabold uppercase tracking-[0.28em]"
      >
        {section.hsbEyebrow}
      </p>
      <h2 class="type-display-lg">{section.hsbHeading}</h2>
      <p
        class="type-lede text-mist/75"
        set:html={section.hsbLedeHtml}
      />
      <Button
        href={section.hsbButtonHref}
        tone={section.hsbButtonTone ?? "surge"}
        external={Boolean(section.hsbButtonExternal)}
      >
        {section.hsbButtonLabel}
      </Button>
    </div>
  </div>
</Section>
