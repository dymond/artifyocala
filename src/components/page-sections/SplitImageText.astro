---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import type { PageSection } from "../../lib/page-sections/schema";
import { imageAlt } from "../../lib/image-alt";

interface Props {
  section: Extract<PageSection, { _template: "splitImageText" }>;
}

const { section } = Astro.props;
const sitAlt = imageAlt(section.sitImageAlt, `${section.sitHeading} — photo`);
const variant = section.sitVariant === "dark" ? "dark" : undefined;
const imageLeft = section.sitImagePosition === "left";
---

<Section variant={variant}>
  <div
    class="grid grid-cols-1 items-center gap-xl lg:grid-cols-[1fr_0.9fr]"
  >
    <div class:list={["min-w-0", imageLeft && "lg:order-2"]}>
      <h2 class="type-display-lg">{section.sitHeading}</h2>
      <p
        class:list={[
          "artify-rte mb-md max-w-[40rem] [&_a]:font-medium [&_a]:text-accent-soft [&_a]:no-underline hover:[&_a]:underline",
          variant === "dark"
            ? "text-mist/80 dark:[&_a]:text-accent"
            : "type-muted dark:[&_a]:text-accent",
        ]}
        set:html={section.sitBody}
      />
      {
        section.sitButtonLabel?.trim() &&
          section.sitButtonHref?.trim() && (
            <Button
              href={section.sitButtonHref}
              tone={section.sitButtonTone ?? "primary"}
              external={Boolean(section.sitExternal)}
            >
              {section.sitButtonLabel}
            </Button>
          )
      }
    </div>
    <figure
      class:list={[
        "m-0 max-h-[22rem] min-w-0 overflow-hidden rounded-lg",
        imageLeft && "lg:order-1",
      ]}
    >
      <ResponsiveImage
        src={section.sitImage}
        alt={sitAlt}
        width={1152}
        height={2048}
        loading="lazy"
        decoding="async"
        sizes="(min-width: 1024px) 40vw, 92vw"
        class="block h-[22rem] w-full object-cover"
      />
    </figure>
  </div>
</Section>
