---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import type { PageSection } from "../../lib/page-sections/schema";
import {
  homeFigureFrameInkBorderBuzzShadow,
  homeFigureFrameInkBorderSurgeShadow,
  homeFigureImageClip,
} from "../../lib/home-section-figure-frames";
import { imageAlt } from "../../lib/image-alt";

interface Props {
  section: Extract<PageSection, { _template: "homeMeetups" }>;
}

const { section } = Astro.props;
const leftAlt = imageAlt(section.hmuImageLeftAlt, `${section.hmuHeading} — photo`);
const rightAlt = imageAlt(section.hmuImageRightAlt, `${section.hmuHeading} — photo`);
---

<Section id="meetups">
  <p class="type-section-yell">{section.hmuEyebrow}</p>
  <h2 class="type-display-lg">{section.hmuHeading}</h2>
  <p
    class="artify-rte type-lede [&_a]:font-medium [&_a]:text-accent-soft [&_a]:no-underline hover:[&_a]:underline dark:[&_a]:text-accent"
    set:html={section.hmuLedeHtml}
  />
  <div
    class="my-lg grid grid-cols-1 items-start gap-md md:grid-cols-[1.4fr_1fr]"
  >
    <figure class={homeFigureFrameInkBorderBuzzShadow}>
      <div class={homeFigureImageClip}>
        <ResponsiveImage
          src={section.hmuImageLeft}
          alt={leftAlt}
          width={2048}
          height={1365}
          loading="lazy"
          decoding="async"
          sizes="(min-width: 768px) 55vw, 92vw"
          class="block w-full"
        />
      </div>
    </figure>
    <figure class={homeFigureFrameInkBorderSurgeShadow}>
      <div class={homeFigureImageClip}>
        <ResponsiveImage
          src={section.hmuImageRight}
          alt={rightAlt}
          width={1080}
          height={1350}
          loading="lazy"
          decoding="async"
          sizes="(min-width: 768px) 40vw, 92vw"
          class="w-full bg-mist object-contain dark:bg-panel/40"
        />
      </div>
    </figure>
  </div>
  <Button
    href={section.hmuButtonHref}
    tone={section.hmuButtonTone ?? "primary"}
    external={Boolean(section.hmuExternal)}
  >
    {section.hmuButtonLabel}
  </Button>
</Section>
