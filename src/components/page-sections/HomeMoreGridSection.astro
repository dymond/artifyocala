---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import type { PageSection } from "../../lib/page-sections/schema";
import { homeMoreGridCardFrames } from "../../lib/home-more-grid-card-frames";
import { imageAlt } from "../../lib/image-alt";

interface Props {
  section: Extract<PageSection, { _template: "homeMoreGrid" }>;
}

const { section } = Astro.props;
const cards = section.hmgCards ?? [];
---

<Section id="more">
  <p class="type-section-yell">{section.hmgEyebrow}</p>
  <h2 class="type-display-lg">{section.hmgHeading}</h2>
  <p
    class="artify-rte type-lede [&_a]:font-medium [&_a]:text-accent-soft [&_a]:no-underline hover:[&_a]:underline dark:[&_a]:text-accent"
    set:html={section.hmgLedeHtml}
  />
  <div
    class="mt-md grid grid-cols-[repeat(auto-fit,minmax(16rem,1fr))] gap-md"
  >
    {
      cards.map((card, i) => (
        <article
          class:list={[
            "flex flex-col overflow-hidden rounded-xl bg-white/40 p-0 transition-transform duration-300 hover:-translate-y-1 dark:bg-panel/55",
            homeMoreGridCardFrames[i % 3].border,
            homeMoreGridCardFrames[i % 3].shadow,
          ]}
        >
          <div class="aspect-[4/3] overflow-hidden">
            <ResponsiveImage
              src={card.hmgCardImage}
              alt={imageAlt(
                card.hmgCardImageAlt,
                `${card.hmgCardTitle} — photo`,
              )}
              width={1440}
              height={1440}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 1024px) 30vw, 92vw"
              class="h-full w-full object-cover"
            />
          </div>
          <h3 class="mx-lg mb-xs mt-md font-display text-[1.15rem]">
            {card.hmgCardTitle}
          </h3>
          <p class="type-muted mx-lg mb-md">{card.hmgCardDescription}</p>
          <Button
            class="mb-lg ml-lg self-start"
            href={card.hmgCardButtonHref}
            tone="outline"
            external={Boolean(card.hmgCardExternal)}
          >
            {card.hmgCardButtonLabel}
          </Button>
        </article>
      ))
    }
  </div>
</Section>
