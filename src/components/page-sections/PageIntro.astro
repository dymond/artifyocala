---
import Section from "../ui/Section.astro";
import type { PageSection } from "../../lib/page-sections/schema";

interface Props {
  section: Extract<PageSection, { _template: "pageIntro" }>;
}

const { section } = Astro.props;
const src = section.introImage?.trim();
---

<Section>
  <h1 class="type-display-xl">{section.introTitle}</h1>
  {
    section.introLede && (
      <p class="type-lede">{section.introLede}</p>
    )
  }
  {
    src && (
      <figure class="mt-lg max-w-3xl overflow-hidden rounded-lg border border-line">
        <img
          src={src}
          alt={section.introImageAlt ?? ""}
          width={748}
          height={880}
          loading="eager"
          decoding="async"
          class="block w-full"
        />
      </figure>
    )
  }
</Section>
