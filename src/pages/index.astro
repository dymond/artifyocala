---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageVisualEdit from "../components/tina/PageVisualEdit";
import { img } from "../lib/site-images";
import client from "../../tina/__generated__/client";

const tina = await client.queries.page({ relativePath: "home.json" });
const page = tina.data.page;
if (!page) {
  throw new Error('Tina page "home.json" is required for the home page.');
}
const { metaTitle, metaDescription } = page;
---

<BaseLayout
  title={metaTitle ?? "Home"}
  description={metaDescription ?? ""}
  preloadLcpImage={img.logoOnLightHollow}
>
  <PageVisualEdit
    client:tina
    query={tina.query}
    variables={tina.variables}
    data={tina.data}
    pageSlug="home"
  />
</BaseLayout>
