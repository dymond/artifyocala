---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageVisualEdit from "../../components/tina/PageVisualEdit";
import { getCollection } from "astro:content";
import { headerLogoSrc, type SiteChrome } from "../../lib/site-chrome";
import client from "../../lib/tina-graphql-client";
import { resolvePageDescription } from "../../lib/seo";

const tina = await client.queries.page({ relativePath: "home.json" });
const page = tina.data.page;
if (!page) {
  throw new Error('Tina page "home.json" is required for the home page.');
}
const { metaTitle, metaDescription } = page;
const siteChromeList = await getCollection("siteChrome");
const siteChromeEntry = siteChromeList[0];
if (!siteChromeEntry) {
  throw new Error("Missing site settings: add src/content/site/chrome.json (Tina: Site settings).");
}
const siteChrome = siteChromeEntry.data as SiteChrome;
---

<BaseLayout
  title={metaTitle ?? "Home"}
  description={resolvePageDescription(metaDescription)}
  preloadLcpImage={headerLogoSrc(siteChrome)}
  metaRobots="noindex, nofollow"
>
  <PageVisualEdit
    client:tina
    query={tina.query}
    variables={tina.variables}
    data={tina.data}
    pageSlug="home"
    siteChrome={siteChrome}
  />
</BaseLayout>

