---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist or the link is incorrect."
  metaRobots="noindex, nofollow"
>
  <section class="relative dark-surface bg-void py-2xl text-mist md:pb-4xl md:pt-3xl">
    <div id="hal-404-root" class="absolute inset-0 w-full overflow-visible min-h-[min(52vh,28rem)] p-[clamp(0.5rem,2vw,1.25rem)]" > </div>
    <div class="site-container flex flex-col items-center text-center relative z-10 min-h-[calc(100vh-24rem)]" >
      <p class="mb-sm font-display text-[0.7rem] font-extrabold uppercase tracking-[0.28em] text-buzz" >
        404 · signal lost
      </p>
      <h1 class="type-display-lg mb-lg leading-[1.08]">
        You are not supposed to be here
      </h1>
      <div class="mt-sm flex flex-wrap items-center justify-center gap-sm">
        <Button href="/" tone="surge">Return Home</Button>
      </div>

      <div id="hal-404-voice-ui" class="flex w-full max-w-[40rem] flex-col items-center gap-sm mt-auto" >
        <p class="text-center text-[0.85rem] leading-snug text-mist/55">
          Move the pointer over the oracle to wake him. You may need to tap him once to wake him up, but be warned that he can be kinda cranky.
        </p>
        <div class="relative inline-flex shrink-0">
          <button type="button" id="hal-404-play-voice" class="inline-flex items-center justify-center rounded-lg border-2 border-surge bg-transparent px-5 py-3.5 font-display text-xs font-extrabold uppercase tracking-[0.14em] text-mist shadow-[3px_3px_0_0_var(--color-surge)] transition-all duration-200 hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0_0_var(--color-surge)] active:translate-x-1 active:translate-y-1 active:shadow-none" >
            Play system message
          </button>
        </div>
      </div>

      <p id="hal-404-transcript" class="hidden mt-lg max-w-[40rem] text-left text-[0.92rem] leading-relaxed text-mist/72" aria-live="polite" > </p>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    mountHal404Blob,
    muteHal404Speech,
    playHal404Speech,
  } from "../scripts/hal-404-blob";
  import { HAL_404_TRANSCRIPT } from "../lib/hal-404-speech";

  const host = document.getElementById("hal-404-root");
  const transcript = document.getElementById("hal-404-transcript");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (transcript) {
    transcript.textContent = HAL_404_TRANSCRIPT;
    if (reduced) {
      transcript.classList.remove("hidden");
    }
  }

  const voiceUi = document.getElementById("hal-404-voice-ui");
  const playBtn = document.getElementById("hal-404-play-voice");
  const muteBtn = document.getElementById("hal-404-mute-voice");

  if (reduced) {
    voiceUi?.remove();
  } else {
    playBtn?.addEventListener("click", () => playHal404Speech());
    muteBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      muteHal404Speech();
    });
  }

  if (host) {
    mountHal404Blob(host, {
      skipSpeech: reduced,
      skipPointerInteraction: reduced,
    });
  }
</script>
