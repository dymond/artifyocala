---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { LINKS, SITE } from '../../../lib/links';

const mailtoEquipmentDonation = `mailto:${SITE.email}?subject=${encodeURIComponent(
  'Maker Collective — equipment or in-kind donation',
)}`;
const telDigits = SITE.phoneDisplay.replace(/\D/g, '');
const telHref = telDigits.length === 10 ? `tel:+1${telDigits}` : `tel:${telDigits}`;
import { breadcrumbListJsonLd, resolvePageDescription } from '../../../lib/seo';

const programs = await getCollection('programs');
const maker = programs.find((p) => p.id === 'maker-collective');
const makerTitle = maker?.data.title ?? 'Marion County Maker Collective';

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const structuredData = [
  breadcrumbListJsonLd(siteOrigin, [
    { name: 'Home', path: '/' },
    { name: makerTitle, path: '/programs/maker-collective' },
    {
      name: 'Equipment wish list',
      path: '/programs/maker-collective/equipment',
    },
  ]),
];

const sections = await getCollection('equipment');
const sectionOrder = [
  'workshop',
  'hand-tools',
  'other-essentials',
  'fibershop',
  'fiber-materials',
  'fiber-tools',
  'tech-station',
  'laser',
  'vinyl',
  'jewelry',
  'performing-arts',
];
const sorted = sections.sort(
  (a, b) => sectionOrder.indexOf(a.id) - sectionOrder.indexOf(b.id),
);
---

<BaseLayout
  title="Equipment wish list"
  description={resolvePageDescription(
    'Equipment and supplies needed for the Marion County Maker Collective makerspace in Ocala, Florida.',
  )}
  structuredData={structuredData}
>
  <Section>
    <h1 class="type-display-xl">Equipment wish list</h1>
    <p class="type-lede">
      Help equip the Marion County Maker Collective. Below is the community wish list, organized by area.
    </p>
    <div class="flex flex-wrap gap-sm">
      <Button href={LINKS.zeffyDonate} external>Donate</Button>
      <Button href="/programs/maker-collective" tone="outline">Back to Maker Collective</Button>
    </div>
  </Section>

  <Section variant="dark">
    <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-lg">
      {
        sorted.map((s) => (
          <section class="rounded-lg border border-white/10 bg-panel p-lg">
            <h2 class="mb-md font-display text-[1.15rem]">{s.data.title}</h2>
            <ul class="my-0 list-disc pl-[1.1rem] text-[0.92rem] leading-[1.55] text-mist/80">
              {s.data.items.map((item) => (
                <li class="mb-[0.35rem]">{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
      <aside
        class="flex flex-col rounded-lg border border-white/10 bg-panel p-lg"
        aria-labelledby="equipment-donate-aside-title"
      >
        <p
          class="mb-xs font-display text-[0.65rem] font-extrabold uppercase tracking-[0.22em] text-buzz"
        >
          In-kind gifts
        </p>
        <h2
          id="equipment-donate-aside-title"
          class="mb-md font-display text-[1.15rem] leading-snug"
        >
          Donate equipment
        </h2>
        <p class="mb-md text-[0.92rem] leading-[1.55] text-mist/80">
          New or gently used tools and supplies help us outfit the space faster. Reach out before you drop off or ship anything—we’ll confirm what we can take and when someone can receive it.
        </p>
        <div class="space-y-sm text-[0.92rem] leading-[1.55] text-mist/90">
          <p class="m-0">
            <span class="text-mist/55">Email</span>
            <br />
            <a
              class="font-medium text-accent-soft underline decoration-accent-soft/45 underline-offset-2 hover:decoration-accent-soft"
              href={mailtoEquipmentDonation}
            >
              {SITE.email}
            </a>
          </p>
          <p class="m-0">
            <span class="text-mist/55">Phone</span>
            <br />
            <a
              class="font-medium text-accent-soft underline decoration-accent-soft/45 underline-offset-2 hover:decoration-accent-soft"
              href={telHref}
            >
              {SITE.phoneDisplay}
            </a>
          </p>
        </div>
        <p class="mt-auto pt-md text-[0.85rem] leading-[1.5] text-mist/65">
          Prefer to give money instead?{' '}
          <a
            class="font-medium text-mist underline decoration-mist/35 underline-offset-2 hover:decoration-mist"
            href={LINKS.zeffyDonate}
            rel="noopener noreferrer"
            target="_blank"
          >
            Donate online
          </a>
          —we’ll put it toward purchases from this list.
        </p>
      </aside>
    </div>
  </Section>
</BaseLayout>
