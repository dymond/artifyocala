---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramVisualEdit from '../../components/tina/ProgramVisualEdit';
import { getCollection } from 'astro:content';
import client from "../../lib/tina-graphql-client";

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs.map((entry) => ({
    params: { slug: entry.id },
    props: {
      slug: entry.id,
      getTinaProps: async () =>
        client.queries.program({ relativePath: `${entry.id}.mdx` }),
    },
  }));
}

const { slug, getTinaProps } = Astro.props;
const tina = await getTinaProps();
const program = tina.data.program;

if (!program) {
  throw new Error(`Tina program not found for slug "${slug}"`);
}
---

<BaseLayout title={program.title} description={program.description}>
  <ProgramVisualEdit
    client:tina
    query={tina.query}
    variables={tina.variables}
    data={tina.data}
    slug={slug}
  />
</BaseLayout>
