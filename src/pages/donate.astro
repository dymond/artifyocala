---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import { LINKS } from '../lib/links';
import { img } from '../lib/site-images';
---

<BaseLayout
  title="Donate"
  description="Support Artify Ocala — a 501(c)(3) nonprofit bringing free and low-cost arts programs to Marion County."
>
  <Section>
    <h1 class="type-display-xl">Donate</h1>
    <p class="type-lede">
      Artify Ocala is a volunteer-run 501(c)(3). Your gifts sustain programs like Brick City Glam,
      Storytelling Knights, and the Marion County Maker Collective.
    </p>
    <div class="flex flex-wrap gap-sm">
      <Button href={LINKS.zeffyMakerspaceDonation} external>Support the makerspace</Button>
      <Button href={LINKS.zeffyGetInvolved} tone="outline" external>Give via Zeffy ticketing</Button>
    </div>
    <figure class="mt-xl max-w-md overflow-hidden rounded-lg border border-line">
      <img
        src={img.createArtCommunity}
        alt="Community creating art together"
        width={1080}
        height={1080}
        loading="eager"
        decoding="async"
        class="block w-full"
      />
    </figure>
  </Section>

  <Section variant="dark">
    <h2 class="type-display-lg">Where it goes</h2>
    <ul class="my-0 pl-[1.2rem] leading-[1.8] text-mist/85">
      <li>Free and low-cost workshops and events</li>
      <li>Performance opportunities and artist development</li>
      <li>Makerspace launch: tools, facility, instructors, outreach</li>
    </ul>
  </Section>
</BaseLayout>
