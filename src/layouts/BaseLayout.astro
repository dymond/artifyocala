---
import { getCollection } from 'astro:content';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { SiteChrome } from '../lib/site-chrome';
import { img } from '../lib/site-images';
import { LINKS, SITE } from '../lib/links';
import { absoluteUrl, resolvePageDescription } from '../lib/seo';
import '../styles/global.css';

// Preload the primary body font so text LCP isn't delayed by font swap.
// Use Vite `?url` so the emitted filename is correct (hashed) in dist.
import instrumentSansLatinNormalUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import syneLatinWoff2Url from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';

const siteChromeList = await getCollection("siteChrome");
const siteChromeEntry = siteChromeList[0];
if (!siteChromeEntry) {
  throw new Error(
    'Missing site settings: add src/content/site/chrome.json (Tina: Site settings).',
  );
}
const siteChrome = siteChromeEntry.data as SiteChrome;

interface Props {
  title: string;
  description?: string;
  /** Optional: preload likely LCP image (e.g. home hero logo path from site-images). */
  preloadLcpImage?: string;
  /** Override default robots meta (use `noindex, nofollow` on error pages). */
  metaRobots?: string;
  /** Extra JSON-LD nodes merged after WebSite / Organization / WebPage (e.g. Article, BreadcrumbList). */
  structuredData?: Record<string, unknown>[];
  /** Per-page Open Graph overrides (default: site-wide social share PNG). */
  openGraph?: {
    type?: 'website' | 'article';
    image?: {
      url: string;
      alt?: string;
      width?: number;
      height?: number;
    };
  };
}

const {
  title,
  description,
  preloadLcpImage,
  metaRobots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  structuredData = [],
  openGraph,
} = Astro.props;

const pageDescription = resolvePageDescription(description);

const fullTitle = title === 'Home' ? 'Artify Ocala' : `${title} · Artify Ocala`;
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageUrl = new URL(canonicalPath, Astro.site);
const siteRootUrl = new URL('/', Astro.site).href;
const siteOrigin = pageUrl.origin;
const shareImageUrl = new URL(img.socialShareCard, Astro.site).href;
const logoUrl = new URL(img.logoOnLightHollow, Astro.site).href;

/** Matches `public/images/artify-ocala-social-share.png` (Open Graph / share preview). */
const shareImageWidth = 2400;
const shareImageHeight = 1260;
const shareImageAlt = 'Artify Ocala — logo on dark background with lavender circle motif';

const ogFromProps = openGraph?.image;
const ogImageUrl = ogFromProps?.url
  ? absoluteUrl(siteOrigin, ogFromProps.url)
  : shareImageUrl;
const ogImageAlt = ogFromProps?.alt ?? shareImageAlt;
const ogImageWidth = ogFromProps?.width ?? shareImageWidth;
const ogImageHeight = ogFromProps?.height ?? shareImageHeight;
const ogType = openGraph?.type ?? 'website';
const ogImageMime = /\.jpe?g(\?|$)/i.test(ogImageUrl) ? 'image/jpeg' : 'image/png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteRootUrl,
      name: SITE.name,
      description: SITE.tagline,
      inLanguage: 'en-US',
      publisher: { '@id': `${siteOrigin}/#organization` },
    },
    {
      '@type': 'NGO',
      '@id': `${siteOrigin}/#organization`,
      name: SITE.name,
      alternateName: 'Artify',
      url: siteRootUrl,
      description: SITE.tagline,
      email: SITE.email,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
      },
      sameAs: [LINKS.instagram, LINKS.facebook],
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl.href}#webpage`,
      url: pageUrl.href,
      name: title,
      description: pageDescription,
      isPartOf: { '@id': `${siteOrigin}/#website` },
      inLanguage: 'en-US',
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: ogImageWidth,
        height: ogImageHeight,
      },
    },
    ...structuredData,
  ],
};

/*
  Partytown (@astrojs/partytown) runs third-party scripts in a web worker.
  Do NOT move Alpine or site UI scripts into Partytown.

  When you add GA4 / GTM, use type="text/partytown" on those script tags only.
  astro.config.mjs already forwards dataLayer.push for common GTM setups.
*/
const analyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={metaRobots} />
    <meta name="theme-color" content="#1c1c33" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12122a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={pageUrl.href} />
    <link
      rel="preload"
      href={instrumentSansLatinNormalUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={syneLatinWoff2Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadLcpImage ? (
        <link rel="preload" href={preloadLcpImage} as="image" fetchpriority="high" />
      ) : null
    }
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{fullTitle}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content={ogImageMime} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      analyticsId ? (
        <>
          <script
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}
          />
          <script type="text/partytown" define:vars={{ analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', analyticsId);
          </script>
        </>
      ) : null
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Processed & bundled by Astro (no attributes other than `src`). -->
    <script src="/src/scripts/program-cards-tilt-init.ts"></script>
    <script src="/src/scripts/site-effects.ts"></script>
    <Header chrome={siteChrome} />
    <main class="w-full min-w-0 flex-1">
      <slot />
    </main>
    <Footer chrome={siteChrome} />
  </body>
</html>
