---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { SiteChrome } from '../lib/site-chrome';
import { img } from '../lib/site-images';
import { LINKS, SITE } from '../lib/links';
import '../styles/global.css';

const siteChromeList = await getCollection("siteChrome");
const siteChromeEntry = siteChromeList[0];
if (!siteChromeEntry) {
  throw new Error(
    'Missing site settings: add src/content/site/chrome.json (Tina: Site settings).',
  );
}
const siteChrome = siteChromeEntry.data as SiteChrome;

interface Props {
  title: string;
  description?: string;
  /** Optional: preload likely LCP image (e.g. home hero logo path from site-images). */
  preloadLcpImage?: string;
  /** Override default robots meta (use `noindex, nofollow` on error pages). */
  metaRobots?: string;
}

const {
  title,
  description = 'Artify Ocala — art, performance, and making in Marion County, Florida.',
  preloadLcpImage,
  metaRobots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const fullTitle = title === 'Home' ? 'Artify Ocala' : `${title} · Artify Ocala`;
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageUrl = new URL(canonicalPath, Astro.site);
const siteRootUrl = new URL('/', Astro.site).href;
const siteOrigin = pageUrl.origin;
const shareImageUrl = new URL(img.socialShareCard, Astro.site).href;
const logoUrl = new URL(img.logoOnLightHollow, Astro.site).href;

/** Matches `public/images/artify-ocala-social-share.png` (Open Graph / share preview). */
const shareImageWidth = 2400;
const shareImageHeight = 1260;
const shareImageAlt = 'Artify Ocala — logo on dark background with lavender circle motif';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteRootUrl,
      name: SITE.name,
      description,
      inLanguage: 'en-US',
      publisher: { '@id': `${siteOrigin}/#organization` },
    },
    {
      '@type': 'NGO',
      '@id': `${siteOrigin}/#organization`,
      name: SITE.name,
      alternateName: 'Artify',
      url: siteRootUrl,
      description: SITE.tagline,
      email: SITE.email,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
      },
      sameAs: [LINKS.instagram, LINKS.facebook],
    },
  ],
};

/*
  Partytown (@astrojs/partytown) runs third-party scripts in a web worker.
  Do NOT move Alpine or site UI scripts into Partytown.

  When you add GA4 / GTM, use type="text/partytown" on those script tags only.
  astro.config.mjs already forwards dataLayer.push for common GTM setups.
*/
const analyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={metaRobots} />
    <meta name="theme-color" content="#1c1c33" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12122a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={pageUrl.href} />
    {
      preloadLcpImage ? (
        <link rel="preload" href={preloadLcpImage} as="image" fetchpriority="high" />
      ) : null
    }
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImageWidth)} />
    <meta property="og:image:height" content={String(shareImageHeight)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
    {
      analyticsId ? (
        <>
          <script
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}
          />
          <script type="text/partytown" define:vars={{ analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', analyticsId);
          </script>
        </>
      ) : null
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <Header chrome={siteChrome} />
    <main class="w-full min-w-0 flex-1">
      <slot />
    </main>
    <Footer chrome={siteChrome} />
  </body>
</html>
