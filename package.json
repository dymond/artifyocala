{
  "name": "artifyocala",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:astro": "astro dev",
    "dev:netlify": "ARTIFY_NETLIFY_DEV=1 astro dev",
    "build": "tinacms build --no-client-build-cache --skip-search-index && node scripts/remove-tina-generated-client.mjs && astro build",
    "build:deploy": "tinacms build --skip-search-index --skip-cloud-checks && node scripts/remove-tina-generated-client.mjs && astro build",
    "build:netlify:ci": "node scripts/netlify-build.mjs",
    "build:netlify-parity": "rm -rf node_modules/.vite dist && pnpm rebuild esbuild && NETLIFY=true pnpm exec astro build",
    "build:offline": "tinacms build --local --skip-cloud-checks --datalayer-port 9010 --no-client-build-cache --skip-search-index && node scripts/remove-tina-generated-client.mjs && astro build",
    "build:netlify": "netlify build --offline",
    "build:netlify:online": "netlify build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:hal404-audio": "python3 scripts/generate-hal-404-audio.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm test && HEAD=main NETLIFY_BRANCH=main netlify build --offline",
    "audit:lighthouse": "lhci autorun",
    "audit:pagespeed": "node scripts/pagespeed-insights.mjs",
    "images:build": "node scripts/images-build.mjs",
    "verify:predeploy": "pnpm test && NETLIFY=true pnpm run images:build && NETLIFY=true pnpm exec astro build && pnpm run audit:lighthouse"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/netlify": "^7.0.6",
    "@astrojs/partytown": "^2.1.6",
    "@astrojs/react": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@tinacms/cli": "^2.2.1",
    "@types/alpinejs": "^3.13.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "alpinejs": "^3.15.11",
    "astro": "^6.1.3",
    "lil-gui": "^0.21.0",
    "netlify": "^24.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "tinacms": "^3.7.1",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "better-sqlite3",
      "core-js",
      "protobufjs",
      "unix-dgram"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@squoosh/lib": "^0.5.3",
    "@tailwindcss/vite": "^4.2.2",
    "jsdom": "^29.0.1",
    "netlify-cli": "^24.9.0",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.0",
    "vitest": "^4.1.2"
  }
}
