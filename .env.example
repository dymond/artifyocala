# Copy to `.env` for local development (never commit `.env`).
#
# Netlify: set PUBLIC_TINA_CLIENT_ID and TINA_TOKEN in the site environment.
# Local:   use TINA_TOKEN_LOCAL (can be a different read-only token than Netlify).
# Optional: TINA_CONTENT_BRANCH=some-branch (override Tina Content API + media branch).
# On Netlify, `BRANCH` is set automatically and is preferred over custom NETLIFY_BRANCH.
# Optional Netlify only: FORCE_TINA_BUILD=1 (always run tinacms build), or SKIP_TINA_BUILD=1 (never run tinacms; risky).

PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN_LOCAL=

# Optional: Netlify “Deploys” page URL, shown to editors after save (defaults to artify site).
# PUBLIC_NETLIFY_DEPLOYS_URL=

# Optional: Google PageSpeed Insights API (for `pnpm run audit:pagespeed` — prints to terminal only; no files).
# Enable "PageSpeed Insights API" in Google Cloud Console and create an API key.
# PAGESPEED_INSIGHTS_API_KEY=
