# Copy to `.env` for local development (never commit `.env`).
#
# Netlify: set PUBLIC_TINA_CLIENT_ID and TINA_TOKEN in the site environment.
# Local:   use TINA_TOKEN_LOCAL (can be a different read-only token than Netlify).
# Optional Netlify: TINA_CONTENT_BRANCH=main (default for deploy-preview/branch-deploy is main in tina/config.ts).

PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN_LOCAL=

# Optional: Netlify “Deploys” page URL, shown to editors after save (defaults to artify site).
# PUBLIC_NETLIFY_DEPLOYS_URL=
